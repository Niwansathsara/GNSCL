rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSiteAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'niwansathsara76@gmail.com';
    }

    function validVideo(data, videoId) {
      return data.keys().hasOnly([
          'id',
          'title',
          'mainPlaylist',
          'playlist',
          'subject',
          'teacher',
          'url',
          'description',
          'createdAt'
        ])
        && data.keys().hasAll([
          'id',
          'title',
          'mainPlaylist',
          'playlist',
          'subject',
          'teacher',
          'url',
          'description',
          'createdAt'
        ])
        && data.id == videoId
        && data.id is string
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 100
        && data.mainPlaylist is string
        && data.mainPlaylist.size() > 0
        && data.mainPlaylist.size() <= 80
        && data.playlist is string
        && data.playlist.size() > 0
        && data.playlist.size() <= 80
        && data.subject is string
        && data.subject.size() > 0
        && data.subject.size() <= 40
        && data.teacher is string
        && data.teacher.size() <= 80
        && data.url is string
        && data.url.size() <= 500
        && data.description is string
        && data.description.size() <= 180
        && data.createdAt is number;
    }

    match /videos/{videoId} {
      // Library metadata is available only after Firebase Authentication.
      allow read: if request.auth != null;

      allow create, update: if isSiteAdmin()
        && validVideo(request.resource.data, videoId);

      allow delete: if isSiteAdmin();
    }

    // Public homepage summary: exposes only aggregate counts, never video details or user information.
    match /publicStats/{statsId} {
      allow read: if statsId == 'library';
      allow create, update: if statsId == 'library'
        && isSiteAdmin()
        && request.resource.data.keys().hasOnly(['videoCount', 'subjectCount', 'updatedAt'])
        && request.resource.data.keys().hasAll(['videoCount', 'subjectCount', 'updatedAt'])
        && request.resource.data.videoCount is int
        && request.resource.data.videoCount >= 0
        && request.resource.data.subjectCount is int
        && request.resource.data.subjectCount >= 0
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Counter registry: document IDs are Firebase UIDs; no emails or display names are stored.
    // Only signed-in members can read these minimal counter records.
    match /libraryUsers/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.keys().hasAll(['createdAt'])
        && request.resource.data.createdAt == request.time;
      allow delete: if false;
    }

    // Presence heartbeat: each signed-in user may update only their own last-seen timestamp.
    match /sitePresence/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['lastSeen'])
        && request.resource.data.keys().hasAll(['lastSeen'])
        && request.resource.data.lastSeen == request.time;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
